@model InstallmentAdminPanel.Models.Vendor
@{
    ViewData["Title"] = "Add Vendor";
    ViewBag.Active = "Vendors";
}

<div class="page-header">
    <div>
        <h1>Add Vendor</h1>
        <div class="subtitle">Register a supplier so you can link products to them.</div>
    </div>
</div>

<form asp-action="Create" method="post" class="card p-4" style="max-width: 720px;">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Business Name</label>
            <input asp-for="BusinessName" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Contact Person</label>
            <input asp-for="ContactPerson" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Phone Number</label>
            <input asp-for="Phone" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Email (optional)</label>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="col-md-12">
            <label class="form-label">Business Address</label>
            <input asp-for="Address" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Product Category</label>
            <select class="form-select">
                <option>Electronics</option>
                <option>Mobile Phones</option>
                <option>Home Appliances</option>
                <option>Furniture</option>
                <option>Motorbikes</option>
                <option>Other</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Payment Terms</label>
            <input class="form-control" placeholder="e.g. Pay within 30 days" />
        </div>
    </div>

    <div class="d-flex gap-2 pt-3 mt-3" style="border-top:1px solid var(--line);">
        <button type="submit" class="btn btn-brass">Save Vendor</button>
        <a asp-action="Index" class="btn btn-ghost">Cancel</a>
    </div>
</form>
