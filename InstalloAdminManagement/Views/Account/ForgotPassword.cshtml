@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reset Password &mdash; Installment Ledger</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" />
</head>
<body>
    <div class="login-wrap">
        <div class="login-card">
            <div class="login-mark">L</div>
            <h1 style="font-size:22px;margin-bottom:2px;">Reset your password</h1>
            <p class="text-slate" style="font-size:13px;margin-bottom:24px;">We'll send a reset link to your registered email or phone.</p>
            <form>
                <div class="mb-3">
                    <label class="form-label">Email or Phone</label>
                    <input class="form-control" placeholder="owner@yourstore.com" />
                </div>
                <button type="submit" class="btn btn-brass w-100">Send Reset Link</button>
            </form>
            <a asp-controller="Account" asp-action="Login" class="d-block text-center mt-3" style="font-size:12.5px;">&larr; Back to sign in</a>
        </div>
    </div>
</body>
</html>
