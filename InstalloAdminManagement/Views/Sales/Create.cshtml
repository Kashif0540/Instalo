@model InstallmentAdminPanel.Models.SaleCreateViewModel
@{
    ViewData["Title"] = "New Installment Sale";
    ViewBag.Active = "Sales";
}

<div class="page-header">
    <div>
        <h1>New Installment Sale</h1>
        <div class="subtitle">Pick a customer, a product and a plan — the schedule is generated automatically.</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <form asp-action="Create" method="post" class="card p-4">
            <div class="form-section-title">1. Customer</div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">Select Customer</label>
                    <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select">
                        <option value="">Search customer...</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <a asp-controller="Customers" asp-action="Create" class="btn btn-outline-ink w-100">+ New Customer</a>
                </div>
            </div>

            <div class="form-section-title">2. Product</div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">Select Product</label>
                    <select asp-for="ProductId" asp-items="Model.Products" class="form-select">
                        <option value="">Search product...</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Quantity</label>
                    <input asp-for="Quantity" type="number" value="1" class="form-control mono" />
                </div>
            </div>

            <div class="form-section-title">3. Installment Plan</div>
            <div class="row g-3">
                <div class="col-md-12">
                    <label class="form-label">Select Plan</label>
                    <select asp-for="InstallmentPlanId" asp-items="Model.Plans" class="form-select">
                        <option value="">Choose a plan template...</option>
                    </select>
                    <div class="field-hint">Manage plan templates under Installment Plans.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Down Payment Received (Rs)</label>
                    <input asp-for="DownPaymentReceived" type="number" class="form-control mono" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Sale Date</label>
                    <input asp-for="SaleDate" type="date" class="form-control" />
                </div>
            </div>

            <div class="form-section-title">4. Guarantor Confirmation</div>
            <div class="guarantor-block">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="confirmGuarantor" />
                    <label class="form-check-label" for="confirmGuarantor" style="font-size:13px;">
                        I confirm this customer has at least one verified guarantor on file.
                    </label>
                </div>
            </div>

            <div class="d-flex gap-2 pt-3 mt-2" style="border-top:1px solid var(--line);">
                <button type="submit" class="btn btn-brass">Create Sale &amp; Generate Schedule</button>
                <a asp-action="Index" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>

    <div class="col-lg-4">
        <div class="card p-3">
            <h2 style="font-size:15px;">Sale Summary</h2>
            <div class="divider-label">Pricing</div>
            <div class="d-flex justify-content-between mb-1"><span class="text-slate">Product Price</span><span class="amount">Rs 0</span></div>
            <div class="d-flex justify-content-between mb-1"><span class="text-slate">Markup</span><span class="amount">Rs 0</span></div>
            <div class="d-flex justify-content-between mb-1"><span class="text-slate">Down Payment</span><span class="amount">- Rs 0</span></div>
            <div class="d-flex justify-content-between pt-2 mt-2" style="border-top:1px solid var(--line);font-weight:600;">
                <span>Total Payable</span><span class="amount">Rs 0</span>
            </div>

            <div class="divider-label">Schedule Preview</div>
            <p class="cell-sub">Select a product and plan to generate the installment schedule automatically.</p>
        </div>
    </div>
</div>
