@model IEnumerable<InstallmentAdminPanel.Models.InstallmentPlan>
@{
    ViewData["Title"] = "Installment Plans";
    ViewBag.Active = "Plans";
}

<div class="page-header">
    <div>
        <h1>Installment Plans</h1>
        <div class="subtitle">Reusable plan templates — duration, down payment, markup and frequency.</div>
    </div>
    <a asp-action="Create" class="btn btn-brass">+ New Plan Template</a>
</div>

<div class="row g-3">
    @if (Model != null && Model.Any())
    {
        @foreach (var plan in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h2 style="font-size:16px;margin:0;">@plan.Name</h2>
                        @if (plan.IsActive)
                        {
                            <span class="stamp stamp-active">Active</span>
                        }
                        else
                        {
                            <span class="stamp stamp-inactive">Off</span>
                        }
                    </div>
                    <div class="cell-sub mb-3">@plan.Description</div>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <div class="stat-label">Duration</div>
                            <div class="mono" style="font-size:15px;">@plan.DurationMonths months</div>
                        </div>
                        <div class="col-6">
                            <div class="stat-label">Frequency</div>
                            <div class="mono" style="font-size:15px;">@plan.PaymentFrequency</div>
                        </div>
                        <div class="col-6">
                            <div class="stat-label">Down Payment</div>
                            <div class="mono" style="font-size:15px;">@plan.DownPaymentPercent%</div>
                        </div>
                        <div class="col-6">
                            <div class="stat-label">Markup / Interest</div>
                            <div class="mono" style="font-size:15px;">@plan.MarkupPercent%</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-auto pt-2" style="border-top:1px solid var(--line);">
                        <a asp-action="Edit" asp-route-id="@plan.Id" class="btn btn-outline-ink btn-sm flex-fill">Edit</a>
                        <a asp-action="Details" asp-route-id="@plan.Id" class="btn btn-ghost btn-sm flex-fill">In Use By (@plan.ActiveSalesCount)</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card"><div class="empty-state">
                <h3>No plan templates yet</h3>
                <p>Create your first installment plan — e.g. "6 Months, 20% Down, 10% Markup".</p>
                <a asp-action="Create" class="btn btn-brass">+ New Plan Template</a>
            </div></div>
        </div>
    }
</div>
