@model InstallmentAdminPanel.Models.PaymentsPageViewModel
@{
    ViewData["Title"] = "Collections & Payments";
    ViewBag.Active = "Payments";
}

<div class="page-header">
    <div>
        <h1>Collections &amp; Payments</h1>
        <div class="subtitle">Record incoming payments and track overdue installments.</div>
    </div>
    <button class="btn btn-brass" data-bs-toggle="modal" data-bs-target="#recordPaymentModal">+ Record Payment</button>
</div>

<ul class="nav mb-3" style="border-bottom:1px solid var(--line);">
    <li class="nav-item">
        <a class="nav-link active px-3 py-2" style="color:var(--ink);border-bottom:2px solid var(--brass);font-weight:600;font-size:13.5px;" href="#">Due Today &amp; Upcoming</a>
    </li>
    <li class="nav-item">
        <a class="nav-link px-3 py-2 text-slate" style="font-size:13.5px;" href="#">Overdue (@Model.OverdueCount)</a>
    </li>
    <li class="nav-item">
        <a class="nav-link px-3 py-2 text-slate" style="font-size:13.5px;" href="#">Payment History</a>
    </li>
</ul>

<div class="card">
    <table class="table-ledger">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Product</th>
                <th>Installment</th>
                <th>Due Date</th>
                <th>Amount Due</th>
                <th>Late Fee</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Installments != null && Model.Installments.Any())
            {
                @foreach (var i in Model.Installments)
                {
                    <tr>
                        <td>
                            <div class="cell-name">@i.CustomerName</div>
                            <div class="cell-sub">@i.CustomerPhone</div>
                        </td>
                        <td>@i.ProductName</td>
                        <td class="mono">@i.InstallmentNumber / @i.TotalInstallments</td>
                        <td class="mono">@i.DueDate.ToString("dd MMM yyyy")</td>
                        <td class="amount">Rs @i.AmountDue.ToString("N0")</td>
                        <td class="amount">
                            @if (i.LateFee > 0)
                            {
                                <span class="text-danger">Rs @i.LateFee.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="text-slate">&mdash;</span>
                            }
                        </td>
                        <td>
                            @switch (i.Status)
                            {
                                case "Paid":
                                    <span class="stamp stamp-paid">Paid</span>
                                    break;
                                case "Overdue":
                                    <span class="stamp stamp-overdue">Overdue &middot; @i.DaysLate d</span>
                                    break;
                                default:
                                    <span class="stamp stamp-due">Due</span>
                                    break;
                            }
                        </td>
                        <td class="text-end">
                            @if (i.Status != "Paid")
                            {
                                <button class="btn btn-brass btn-sm" data-bs-toggle="modal" data-bs-target="#recordPaymentModal">Collect</button>
                            }
                            else
                            {
                                <a asp-action="Receipt" asp-route-id="@i.Id" class="btn btn-ghost btn-sm">Receipt</a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="8"><div class="empty-state"><h3>Nothing due</h3><p>All installments are up to date.</p></div></td></tr>
            }
        </tbody>
    </table>
</div>

<!-- Record Payment Modal -->
<div class="modal fade" id="recordPaymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="border-bottom:1px solid var(--line);">
                <h2 style="font-size:16px;margin:0;">Record a Payment</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Payments" asp-action="Record" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Customer / Installment</label>
                        <select class="form-select">
                            <option>Search customer or sale...</option>
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Amount Received</label>
                            <input type="number" class="form-control mono" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Payment Date</label>
                            <input type="date" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Payment Method</label>
                            <select class="form-select">
                                <option>Cash</option>
                                <option>Bank Transfer</option>
                                <option>Mobile Wallet (JazzCash/EasyPaisa)</option>
                                <option>Cheque</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Late Fee to Apply</label>
                            <input type="number" class="form-control mono" placeholder="Auto-calculated" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Note (optional)</label>
                            <input type="text" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid var(--line);">
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-brass">Save Payment &amp; Print Receipt</button>
                </div>
            </form>
        </div>
    </div>
</div>
